#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <behaviors/runtime-sensor-rotate.dtsi>

#define BASE   0
#define RAISE  1
#define LOWER  2
#define ADJUST 3
#define EXTRA  4
#define SCROLL 5
#define MOUSE  6

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&trackball {
    automouse-layer = <MOUSE>;
    scroll-layers = <SCROLL>;
};

/ {
    combos {
        compatible = "zmk,combos";

        tab {
            bindings = <&kp TAB>;
            key-positions = <0 1>;
        };

        ri {
            bindings = <&kp RIGHT_CONTROL>;
            key-positions = <21 20>;
        };

        l1 {
            bindings = <&kp LANGUAGE_1>;
            key-positions = <1 0>;
        };

        lann {
            bindings = <&kp LANGUAGE_2>;
            key-positions = <11 10>;
        };

        cl {
            bindings = <&kp LEFT_CONTROL>;
            key-positions = <14 13>;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";
        tri_layer {
            if-layers = <RAISE LOWER>;
            then-layer = <ADJUST>;
        };
    };

    behaviors {
        // ロータリーエンコーダー（DYA Studioから変更可。以下は初期値）
        rsr_vol: rsr_vol {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <5>;
            cw-binding = <&kp C_VOL_UP>;
            ccw-binding = <&kp C_VOL_DN>;
        };
        rsr_scrl: rsr_scrl {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <20>;
            cw-binding = <&msc SCRL_DOWN>;
            ccw-binding = <&msc SCRL_UP>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&kp Q      &kp W   &kp E     &kp R      &kp T                         &kp Y     &kp U  &kp I      &kp O    &kp P
&kp A      &kp S   &kp D     &kp F      &kp G        &mkp RCLK        &kp LBKT  &kp H  &kp J      &kp K    &kp L         &kp MINUS
&kp LSHFT  &kp Z   &kp X     &kp C      &kp V        &kp B            &kp N     &kp M  &kp COMMA  &kp DOT  &kp RS(FSLH)  &kp EQUAL
&kp LCTRL  &kp TAB &kp CAPS  &kp LGUI   &lt RAISE SPACE  &mkp LCLK    &lt LOWER RET &kp BSPC                             &lt SCROLL RBKT
            >;
            sensor-bindings = <&rsr_vol &rsr_trans>;
        };

        raise_layer {
            display-name = "Raise";
            bindings = <
&kp F1    &kp F2    &kp F3     &kp F4   &kp F5                      &kp F6    &kp F7    &kp F8    &kp F9        &kp F10
&kp F11   &kp F12   &none      &none    &none    &trans             &none     &kp LEFT  &kp DOWN  &kp UP        &kp RIGHT     &kp C_MUTE
&trans    &kp LEFT  &kp DOWN   &kp UP   &kp RIGHT &none             &kp HOME  &kp PG_DN &kp PG_UP &kp END       &kp C_VOL_DN  &kp C_VOL_UP
&trans    &trans    &trans     &trans   &trans   &trans             &trans    &kp DEL                                        &trans
            >;
            sensor-bindings = <&rsr_trans &rsr_trans>;
        };

        lower_layer {
            display-name = "Lower";
            bindings = <
&kp N1      &kp N2      &kp N3      &kp N4      &kp N5                           &kp N6      &kp N7      &kp N8      &kp N9      &kp N0
&kp LS(N1)  &kp LS(N2)  &kp LS(N3)  &kp LS(N4)  &kp LS(N5)  &trans               &kp LS(N6)  &kp LS(N7)  &kp LS(N8)  &kp LS(N9)  &kp LS(N0)  &kp GRAVE
&trans      &kp LANG2   &kp LANG1   &none       &none       &none                &kp BSLH    &kp SQT     &kp SEMI    &kp LS(SQT) &kp LS(SEMI) &kp LS(GRAVE)
&trans      &trans      &trans      &trans      &trans      &trans               &trans      &kp DEL                                          &studio_unlock
            >;
            sensor-bindings = <&rsr_trans &rsr_trans>;
        };

        adjust_layer {
            display-name = "Adjust";
            bindings = <
&bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                    &bt BT_CLR_ALL  &none  &none  &none  &bootloader
&bt BT_CLR    &none         &none         &none         &none         &none             &out OUT_TOG    &none  &none  &none  &none  &none
&none         &none         &none         &none         &none         &none             &studio_unlock  &none  &none  &none  &none  &none
&trans        &trans        &trans        &trans        &trans        &trans            &trans          &trans                      &trans
            >;
            sensor-bindings = <&rsr_trans &rsr_trans>;
        };

        extra_layer {
            display-name = "Extra";
            bindings = <
&trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans          &trans  &trans                          &trans
            >;
            sensor-bindings = <&rsr_trans &rsr_trans>;
        };

        scroll_layer {
            display-name = "Scroll";
            bindings = <
&trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans          &trans  &trans                          &trans
            >;
            sensor-bindings = <&rsr_scrl &rsr_trans>;
        };

        mouse_layer {
            display-name = "Mouse";
            bindings = <
&trans  &trans  &trans  &trans  &trans                  &trans    &trans    &trans    &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans          &trans    &mkp MB1  &mkp MB3  &mkp MB2  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans          &mkp MB4  &mkp MB5  &trans    &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans          &trans    &trans                        &trans
            >;
            sensor-bindings = <&rsr_scrl &rsr_trans>;
        };
    };
};
