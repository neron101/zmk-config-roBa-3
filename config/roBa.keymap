#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <behaviors/runtime-sensor-rotate.dtsi>

#define BASE   0
#define RAISE  1
#define LOWER  2
#define ADJUST 3
#define EXTRA  4
#define SCROLL 5
#define MOUSE  6

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&trackball {
    automouse-layer = <MOUSE>;
    scroll-layers = <SCROLL>;
};

/ {
    combos {
        compatible = "zmk,combos";

        tab {
            bindings = <&kp TAB>;
            key-positions = <0 1>;
        };

        ri {
            bindings = <&kp RIGHT_CONTROL>;
            key-positions = <21 20>;
        };

        l1 {
            bindings = <&kp LANGUAGE_1>;
            key-positions = <1 0>;
        };

        lann {
            bindings = <&kp LANGUAGE_2>;
            key-positions = <11 10>;
        };

        cl {
            bindings = <&kp LEFT_CONTROL>;
            key-positions = <14 13>;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";
        tri_layer {
            if-layers = <RAISE LOWER>;
            then-layer = <ADJUST>;
        };
    };

    behaviors {
        // ロータリーエンコーダー（DYA Studioから変更可。以下は初期値）
        rsr_vol: rsr_vol {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <5>;
            cw-binding = <&kp C_VOL_UP>;
            ccw-binding = <&kp C_VOL_DN>;
        };
        rsr_scrl: rsr_scrl {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <20>;
            cw-binding = <&msc SCRL_DOWN>;
            ccw-binding = <&msc SCRL_UP>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&kp Q      &kp W   &kp E     &kp R      &kp T                         &kp Y     &kp U  &kp I      &kp O    &kp P
&kp A      &kp S   &kp D     &kp F      &kp G        &mkp RCLK        &kp LBKT  &kp H  &kp J      &kp K    &kp L         &kp MINUS
&kp LSHFT  &kp Z   &kp X     &kp C      &kp V        &kp B            &kp N     &kp M  &kp COMMA  &kp DOT  &kp RS(FSLH)  &lt MOUSE FSLH
&kp LCTRL  &kp TAB &kp CAPS  &kp LGUI   &lt RAISE SPACE  &mkp LCLK    &lt LOWER RET &kp BSPC                             &lt SCROLL RBKT
            >;
            sensor-bindings = <&rsr_vol &rsr_trans>;
        };

        raise_layer {
            display-name = "Raise";
            bindings = <
&kp N1     &kp N2     &kp N3     &kp N4   &kp N5                        &kp N6   &kp N7   &kp N8   &kp N9   &kp N0
&kp LEFT   &kp UP     &kp RIGHT  &trans   &kp LANG1  &kp LALT           &trans   &trans   &trans   &trans   &trans   &trans
&trans     &kp LEFT   &kp DOWN   &kp RIGHT &trans    &kp LANG2          &trans   &trans   &trans   &trans   &trans   &trans
&trans     &trans     &trans     &trans   &trans     &trans             &trans   &trans                               &trans
            >;
            sensor-bindings = <&rsr_trans &rsr_trans>;
        };

        lower_layer {
            display-name = "Lower";
            bindings = <
&kp LS(N1)    &kp LS(N2)  &kp LS(N3)     &kp LS(N4)  &kp LS(N5)                     &kp RS(N6)  &kp RS(N7)  &kp RS(N8)  &kp RS(N9)  &kp RS(N0)
&kp LS(LEFT)  &kp LS(UP)  &kp LS(RIGHT)  &trans      &kp LANG1   &kp LALT           &trans      &trans      &trans      &trans      &trans      &trans
&trans        &kp LEFT    &kp DOWN       &kp RIGHT   &trans      &kp LANG2          &trans      &trans      &trans      &trans      &trans      &trans
&trans        &trans      &trans         &trans      &trans      &trans             &trans      &trans                                          &studio_unlock
            >;
            sensor-bindings = <&rsr_trans &rsr_trans>;
        };

        adjust_layer {
            display-name = "Adjust";
            bindings = <
&bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                    &bt BT_CLR_ALL  &none  &none  &none  &bootloader
&bt BT_CLR    &none         &none         &none         &none         &none             &out OUT_TOG    &none  &none  &none  &none  &none
&none         &none         &none         &none         &none         &none             &studio_unlock  &none  &none  &none  &none  &none
&trans        &trans        &trans        &trans        &trans        &trans            &trans          &trans                      &trans
            >;
            sensor-bindings = <&rsr_trans &rsr_trans>;
        };

        extra_layer {
            display-name = "Extra";
            bindings = <
&trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans          &trans  &trans                          &trans
            >;
            sensor-bindings = <&rsr_trans &rsr_trans>;
        };

        scroll_layer {
            display-name = "Scroll";
            bindings = <
&trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans          &trans  &trans                          &trans
            >;
            sensor-bindings = <&rsr_scrl &rsr_trans>;
        };

        mouse_layer {
            display-name = "Mouse";
            bindings = <
&trans  &trans  &trans  &trans  &trans                  &trans    &trans    &trans    &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans          &trans    &mkp MB1  &mkp MB3  &mkp MB2  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans          &mkp MB4  &mkp MB5  &trans    &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans          &trans    &trans                        &trans
            >;
            sensor-bindings = <&rsr_scrl &rsr_trans>;
        };
    };
};
